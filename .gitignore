# Runtime state — created by the installer, never committed
venv/
venv_old/
__pycache__/
*.pyc
.env
mic_device.json
mcp.json
diablo.log
*.log
.diablo.pid

# Generated audio and captures
voice_cache/
audio_cache/
*.wav
*.mp3
*.png
!docs/img/*.png

# Backups written by the patchers in tools/
*.bak
*bak-*
*.preview.py
*-preview.py

# macOS
.DS_Store

# The app's vendored React is committed on purpose — the app must work with no
# network, and 148 KB of pinned files is a smaller liability than a CDN.
!app/vendor/*.js

# graphify build artifacts — regenerable, ~3.7MB
graphify-out/

# Laya checkpoints are trained elsewhere and never committed; the manifest travels with them.
research/laya_diablo/checkpoints/*
!research/laya_diablo/checkpoints/README.md
research/laya_diablo/dist/

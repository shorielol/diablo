# Copy to ~/.diablo/.env and edit. No API keys: Diablo runs entirely on this Mac.

# ─── Brain ────────────────────────────────────────────────────────────────
DIABLO_MODEL=qwen3:14b
OLLAMA_HOST=http://localhost:11434
DIABLO_LLM_TIMEOUT=180

# How long Ollama keeps the model resident after the last request. The model is
# ~9.3 GB, so this is the single biggest lever on idle memory. 10m keeps it warm
# through a working session and releases it when you walk away.
DIABLO_KEEP_ALIVE=10m

# Releases the model after every command and shares one Whisper model between
# wake detection and transcription. Idle drops to roughly 150 MB, and every
# command pays the full 6.5s cold start.
DIABLO_LOW_MEMORY=0

# ─── Listening ────────────────────────────────────────────────────────────
DIABLO_WAKE_WINDOW=2.0
DIABLO_WAKE_MIN_GAP=0.55
DIABLO_WAKE_COOLDOWN=2.5
DIABLO_VAD_THRESHOLD=0.08
DIABLO_HANG_TIME=0.55
DIABLO_LEAD_IN=1.8
DIABLO_MAX_UTTERANCE=12.0
DIABLO_STT_MODEL=base.en

# ─── Voice ────────────────────────────────────────────────────────────────
DIABLO_VOICE_PROFILE=Diablo
DIABLO_VOICEBOX_URL=http://127.0.0.1:17493

# ─── Character ────────────────────────────────────────────────────────────
# 0 none, 1 dry, 2 wry, 3 cheeky
DIABLO_HUMOUR=2
DIABLO_WARMTH=1
DIABLO_FORMALITY=2
DIABLO_ADDRESS=Sir

# ─── Safety ───────────────────────────────────────────────────────────────
DIABLO_OFFLINE=1
DIABLO_MAX_STEPS=14

# D.I.A.B.L.O. Environment Configuration

# ─── Brain ───────────────────────────────────────────────────────────────
# One model is the brain and the eyes: qwen3.5:4b (4.2B, Q4_K_M, 3.3 GB on
# disk). It reads images too, so there is no separate vision model, and there
# is no bigger model to escalate to. Blank or absent means qwen3.5:4b.
#
# Measured on this Mac (M3 Pro, 18 GB), 2026-10-05, a 2,736-token agent turn:
#
#   num_ctx    resident   P50     a 12,539-token prompt
#    8192      3.41 GB   1.28s    silently cut to 4,098 tokens by Ollama
#   16384      3.71 GB   1.31s    whole
#   32768      4.27 GB   0.94s    whole
#
# 32768 is the default. Diablo sends truncate:false, so a prompt that does not
# fit is refused and reported rather than shortened behind your back.
DIABLO_MODEL=qwen3.5:4b
DIABLO_NUM_CTX=32768
DIABLO_NUM_PREDICT=512

# ─── Grounding ───────────────────────────────────────────────────────────
# GoClick-Large (0.8B) proposes where a control is when accessibility and the
# text on screen cannot say. It never clicks: grounding_gate checks every
# point against the control the application publishes under it. The installer
# puts its weights in ~/.diablo/models/goclick-large. It runs in its own
# process and is released after this many idle seconds.
DIABLO_GROUNDER_KEEP_ALIVE=600

# Everything here is read aloud, and thinking is silence with a speaker
# pointed at you.
DIABLO_THINK=0

# ─── Fast path (Phase C) ───────────────────────────────────────────────
# Which decision engine picks a turn's lane before any model runs. "rules"
# is deterministic and measured safe on the Diablo decision corpus; "off"
# sends every turn through the router as before.
DIABLO_DECISION=rules
# The first spoken clip is cut at a clause when the first sentence is longer
# than this many words, so it synthesises sooner. 0 turns it off.
DIABLO_LEAD_WORDS=16

# Network Settings (Symbiosis University Pune)
HTTPS_PROXY=
HTTP_PROXY=
NETWORK_TIMEOUT=30000

# Project Paths
PROJECT_ROOT=/Users/YOUR_USERNAME/.diablo
WORKSPACE_PATH=/Users/YOUR_USERNAME/.diablo/workspace

# Voice & Audio
TTS_VOICE="Daniel (UK)"

# Wake detection uses tiny.en (86 ms per 3s window). The command itself is
# transcribed with base.en (193 ms). Whisper small is more accurate but costs
# roughly 450-600 ms on every single command; run `diablo bench --stt` to
# compare on your own voice before changing this.
DIABLO_STT_MODEL=base.en

# Voice — ElevenLabs. Leave the key blank and Diablo uses the local
# macOS voice instead. Every line spoken is cached to disk, so a
# phrase costs one request ever.
# ELEVENLABS_API_KEY removed
DIABLO_VOICE_ID=Diablo
DIABLO_VOICE_MODEL=eleven_turbo_v2_5

# Set to 1 for strictly local: no ElevenLabs, no web tools.
DIABLO_OFFLINE=0
DIABLO_HOME=/Users/YOUR_USERNAME/.diablo
DIABLO_VOICEBOX_URL=http://127.0.0.1:17493

# Responsiveness (measured, see patch_latency.py)
DIABLO_WAKE_WINDOW=2.0
DIABLO_WAKE_MIN_GAP=0.25
DIABLO_WAKE_COOLDOWN=1.5
# 30m pinned the model in memory whether Diablo was in use or not. 10m keeps
# it warm through a working session and hands the memory back when you walk
# away; the wake word starts the reload, so most of that cost is hidden behind
# the time you spend speaking.
DIABLO_KEEP_ALIVE=10m

# Personality — 0 to 3. Applies to conversation only; task
# reports stay factual whatever these are set to.
DIABLO_HUMOUR=2
DIABLO_WARMTH=1
DIABLO_FORMALITY=2
DIABLO_ADDRESS=Sir
DIABLO_VOICE_PROFILE=Diablo
DIABLO_LOW_MEMORY=0
DIABLO_APP_DEBUG=0
